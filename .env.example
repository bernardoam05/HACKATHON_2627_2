# Host ports for docker compose (copy to .env). Container-internal ports stay fixed.
FRONTEND_PORT=5173
BACKEND_PORT=8001
SIMULATOR_PORT=8100

# --- Backend settings (same as backend/.env.example) ---
ALTICE_MCP_URL=
ALTICE_MCP_TOKEN=
SIM_MCP_URL=http://localhost:8100/mcp
AGENT_MODEL=auto
AGENT_MODEL_REASONING=groq:
AGENT_REASONING_API_KEY=
# Key for the AGENT_MODEL provider (exported at startup as ANTHROPIC_API_KEY, OPENAI_API_KEY, ...)
AGENT_API_KEY=
DB_PATH=home.db
SIM_POLL_SECONDS=2
ALTICE_POLL_SECONDS=7
USE_FAKES=0
# NOW_OVERRIDE=2026-11-19T07:20:00
EMPTY_AFTER_MINUTES=10
FULL_SNAPSHOT_EVERY_RUNS=20
FULL_SNAPSHOT_EVERY_SECONDS=900
INSIGHTS_IN_PROMPT=8
INSIGHT_MIN_CONFIDENCE=0.2
REFLEX_MIN_CONFIDENCE=0.8
REFLEX_MAX_UNDOS=2
OVERRIDE_WINDOW_MINUTES=10
OVERRIDE_COOLDOWN_MINUTES=20
